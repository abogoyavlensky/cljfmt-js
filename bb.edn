{:tasks
 {:init (do (require '[babashka.fs :as fs]
                     '[cheshire.core :as json]
                     '[clojure.edn :as edn]
                     '[clojure.string :as str])
            (defn cljfmt-version
              "deps.edn is the single source of truth for the bundled version."
              []
              (or (-> (slurp "deps.edn") edn/read-string :deps
                      (get 'dev.weavejester/cljfmt) :mvn/version)
                  (throw (ex-info "dev.weavejester/cljfmt not found in deps.edn" {})))))

  :enter (println "Running task:" (:name (current-task)))

  vendor {:doc "Shallow-clone cljfmt at the pinned version into vendor/ — its test suite is not in the jar"
          :task (let [version (cljfmt-version)
                      dir     "vendor/cljfmt"
                      stamp   (str dir "/.version")]
                  (if (and (fs/exists? stamp) (= version (str/trim (slurp stamp))))
                    (println "cljfmt" version "already vendored")
                    (do (println "Vendoring cljfmt" version)
                        (fs/delete-tree dir)
                        (shell "git clone --quiet --depth 1 --branch" version
                               "https://github.com/weavejester/cljfmt.git" dir)
                        (spit stamp version))))}

  build {:doc "Compile the release JS bundle into dist/cljfmt.js"
         :task (shell "npx shadow-cljs release lib")}

  parity {:doc "Diff JS output against JVM cljfmt over every fixture x config"
          :depends [build]
          :task (do ;; Stale outputs from a renamed or deleted fixture would be
                    ;; compared to each other and inflate the identical count.
                    (fs/delete-tree "target/parity")
                    (shell "clojure -M:parity -m parity.jvm")
                    (shell "node scripts/parity/js.mjs")
                    (let [jvm-dir "target/parity/jvm"
                          js-dir  "target/parity/js"
                          names   (sort (map fs/file-name (fs/list-dir jvm-dir)))
                          same?   (fn [name] (= (slurp (fs/file jvm-dir name))
                                                (slurp (fs/file js-dir name))))
                          bad     (remove same? names)]
                      (doseq [name bad]
                        (println)
                        (println "MISMATCH:" name)
                        (shell {:continue true}
                               "diff -u" (str jvm-dir "/" name) (str js-dir "/" name)))
                      (if (seq bad)
                        (do (println)
                            (println "parity:" (count bad) "of" (count names) "differ")
                            (System/exit 1))
                        (println "parity:" (str (count names) "/" (count names)) "identical"))))}

  pack {:doc "Build and npm-pack the release tarball into the repo root"
        :depends [build]
        :task (shell "npm pack")}

  test {:doc "Run the wrapper tests and cljfmt's own suite under node"
        :depends [vendor]
        :task (do (shell "npx shadow-cljs compile test")
                  (shell "node target/test.js"))}

  check {:doc "Everything CI runs: build, tests, JVM parity"
         :depends [build test parity]}

  tag {:doc "Tag HEAD as v<version from package.json> and push it (triggers the release workflow)"
       :task (let [version (-> (slurp "package.json") (json/parse-string true) :version)
                   tag     (str "v" version)]
               (when (str/blank? (str version))
                 (binding [*out* *err*] (println "Could not read version from package.json"))
                 (System/exit 1))
               (when-not (str/blank? (:out (shell {:out :string} "git status --porcelain")))
                 (binding [*out* *err*] (println "Working tree is dirty; commit before tagging."))
                 (System/exit 1))
               (when (zero? (:exit (shell {:continue true :out :string :err :string}
                                          "git rev-parse --verify" (str tag "^{tag}"))))
                 (binding [*out* *err*]
                   (println tag "already exists. Release assets are immutable — bump"
                            "the version in package.json and fix forward."))
                 (System/exit 1))
               (println "Tagging" tag "and pushing to origin...")
               (shell "git tag -a" tag "-m" (str "cljfmt-js " version))
               (shell "git push origin" tag))}}}
